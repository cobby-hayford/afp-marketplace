{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "african-film-producers/content-marketplace",
  "type": "project",
  "description": "African Film Producers Content Marketplace",
  "keywords": [
    "laravel",
    "inertia",
    "react",
    "film",
    "marketplace"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/framework": "^13.17",
    "laravel/reverb": "^1.0",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2.5",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.3",
    "phpunit/phpunit": "^12.5.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#86efac\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan reverb:start --debug\" \"npm run dev\" --names=server,queue,reverb,vite --kill-others"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
